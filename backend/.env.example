# Copy to .env and fill in. Never commit .env.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB="purva_eye_care"

ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Any long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

PORT=5000

# Optional: set if you see "querySrv ECONNREFUSED" on Windows
# DNS_SERVERS="8.8.8.8,1.1.1.1"

# Website address(es) allowed to call this API (comma-separated)
CORS_ORIGIN="http://localhost:5173"
